{
  "name": "respawn-squirrel-extension",
  "displayName": "Squirrel (Respawn)",
  "description": "Full language support for Respawn Entertainment games (Apex Legends, Titanfall). Includes IntelliSense, syntax highlighting, and snippets for Squirrel scripts and config files.",
  "version": "2.6.0",
  "publisher": "zee",
  "icon": "acorn.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Formatters"
  ],
  "keywords": [
    "squirrel",
    "nut",
    "gnut",
    "rson",
    "respawn",
    "apex",
    "titanfall",
    "r5reloaded",
    "vscript",
    "source engine",
    "intellisense"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:squirrel"
  ],
  "contributes": {
    "languages": [
      {
        "id": "squirrel",
        "aliases": [
          "Squirrel",
          "squirrel",
          "Squirrel (Respawn)",
          "VScript"
        ],
        "extensions": [
          ".nut",
          ".gnut"
        ],
        "configuration": "./syntaxes/squirrel.language-configuration.json",
        "icon": {
          "light": "./acorn.png",
          "dark": "./acorn.png"
        }
      },
      {
        "id": "rson",
        "aliases": [
          "RSON",
          "rson",
          "Respawn JSON"
        ],
        "extensions": [
          ".rson"
        ],
        "configuration": "./syntaxes/rson.language-configuration.json"
      },
      {
        "id": "respawn-keyvalues",
        "aliases": [
          "Respawn KeyValues",
          "KeyValues",
          "VDF",
          "Weapon Config",
          "UI Resource"
        ],
        "extensions": [
          ".res",
          ".menu"
        ],
        "filenames": [],
        "filenamePatterns": [
          "**/weapons/**/*.txt",
          "**/aisettings/**/*.txt",
          "**/turrets/**/*.txt",
          "**/damage/**/*.txt"
        ],
        "configuration": "./syntaxes/keyvalues.language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "squirrel",
        "scopeName": "rspn.squirrel",
        "path": "./syntaxes/squirrel.tmLanguage.json"
      },
      {
        "language": "rson",
        "scopeName": "source.rson",
        "path": "./syntaxes/rson.tmLanguage.json"
      },
      {
        "language": "respawn-keyvalues",
        "scopeName": "source.keyvalues",
        "path": "./syntaxes/keyvalues.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "squirrel",
        "path": "./snippets/squirrel.json"
      },
      {
        "language": "respawn-keyvalues",
        "path": "./snippets/keyvalues.json"
      }
    ],
    "configurationDefaults": {
      "[squirrel]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": false,
        "editor.detectIndentation": true,
        "editor.bracketPairColorization.enabled": true,
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": false
        }
      },
      "[rson]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": false
      },
      "[respawn-keyvalues]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": false,
        "editor.bracketPairColorization.enabled": true
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.60.0",
    "typescript": "^5.0.0",
    "@vscode/vsce": "^2.22.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/r-ex/vscode-squirrel-re.git"
  },
  "bugs": {
    "url": "https://github.com/r-ex/vscode-squirrel-re/issues"
  },
  "homepage": "https://github.com/r-ex/vscode-squirrel-re#readme"
}
