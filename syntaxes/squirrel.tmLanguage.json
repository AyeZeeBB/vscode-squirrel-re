{
  "name": "Squirrel (Respawn)",
  "scopeName": "rspn.squirrel",
  "patterns": [
    { "include": "#comments" },
    { "include": "#preprocessor" },
    { "include": "#global-function-forward" },
    { "include": "#global-const-declaration" },
    { "include": "#class" },
    { "include": "#enum" },
    { "include": "#struct" },
    { "include": "#typedef" },
    { "include": "#typed-function-declaration" },
    { "include": "#function-declaration" },
    { "include": "#block" },
    { "include": "#block-contents" }
  ],
  "repository": {
    "all": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#preprocessor" },
        { "include": "#global-function-forward" },
        { "include": "#global-const-declaration" },
        { "include": "#class" },
        { "include": "#enum" },
        { "include": "#struct" },
        { "include": "#typedef" },
        { "include": "#typed-function-declaration" },
        { "include": "#function-declaration" },
        { "include": "#block" },
        { "include": "#block-contents" }
      ]
    },
    "global": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#preprocessor" }
      ]
    },
    "block": {
      "begin": "\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.block.begin.squirrel" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.definition.block.end.squirrel" }
      },
      "patterns": [
        { "include": "#block" },
        { "include": "#block-contents" }
      ]
    },
    "block-contents": {
      "patterns": [
        { "include": "#global" },
        { "include": "#global-function-forward" },
        { "include": "#global-const-declaration" },
        { "include": "#array" },
        { "include": "#vector-literal" },
        { "include": "#asset-literal" },
        { "include": "#constants" },
        { "include": "#strings" },
        { "include": "#typed-function-declaration" },
        { "include": "#function-declaration" },
        { "include": "#lambda-expression" },
        { "include": "#variable" },
        { "include": "#modifiers" },
        { "include": "#for-loop" },
        { "include": "#keywords" },
        { "include": "#typed-variables" },
        { "include": "#method-call" },
        { "include": "#punctuation-braces" },
        { "include": "#operators" },
        { "include": "#operator-assignment" },
        { "include": "#punctuation-terminator" },
        { "include": "#punctuation-comma" },
        { "include": "#punctuation-accessor" },
        { "include": "#identifiers" }
      ]
    },
    "identifiers": {
      "patterns": [
        { "include": "#constant-name" },
        { "include": "#f-identifier" }
      ]
    },

    "global-function-forward": {
      "comment": "Forward declarations like 'global function FunctionName' without body",
      "match": "^\\s*(global)\\s+(function)\\s+([_A-Za-z][\\w]*)\\s*$",
      "captures": {
        "1": { "name": "storage.modifier.global.squirrel" },
        "2": { "name": "storage.type.function.squirrel" },
        "3": { "name": "entity.name.function.squirrel" }
      }
    },

    "global-const-declaration": {
      "comment": "Global const declarations",
      "patterns": [
        {
          "comment": "global const TYPE NAME = value",
          "match": "^\\s*(global)\\s+(const)\\s+(int|float|bool|string|asset|vector)\\s+([_A-Za-z][\\w]*)\\s*(=)?",
          "captures": {
            "1": { "name": "storage.modifier.global.squirrel" },
            "2": { "name": "storage.modifier.const.squirrel" },
            "3": { "name": "storage.type.squirrel" },
            "4": { "name": "variable.other.constant.squirrel" },
            "5": { "name": "keyword.operator.assignment.squirrel" }
          }
        },
        {
          "comment": "global const NAME = value (untyped)",
          "match": "^\\s*(global)\\s+(const)\\s+([_A-Z][_A-Z0-9]*)\\s*(=)?",
          "captures": {
            "1": { "name": "storage.modifier.global.squirrel" },
            "2": { "name": "storage.modifier.const.squirrel" },
            "3": { "name": "variable.other.constant.squirrel" },
            "4": { "name": "keyword.operator.assignment.squirrel" }
          }
        },
        {
          "comment": "const NAME = value",
          "match": "^\\s*(const)\\s+(int|float|bool|string|asset|vector)?\\s*([_A-Za-z][\\w]*)\\s*(=)?",
          "captures": {
            "1": { "name": "storage.modifier.const.squirrel" },
            "2": { "name": "storage.type.squirrel" },
            "3": { "name": "variable.other.constant.squirrel" },
            "4": { "name": "keyword.operator.assignment.squirrel" }
          }
        }
      ]
    },

    "preprocessor": {
      "patterns": [
        {
          "match": "^\\s*(#\\s*(?:if|elseif|elif))\\b(.*)$",
          "captures": {
            "1": { "name": "keyword.control.directive.conditional.squirrel" },
            "2": {
              "patterns": [
                { "include": "#preprocessor-expression" }
              ]
            }
          }
        },
        {
          "match": "^\\s*(#\\s*(?:else|endif))\\b",
          "captures": {
            "1": { "name": "keyword.control.directive.conditional.squirrel" }
          }
        },
        {
          "match": "^\\s*(#\\s*document)\\s*\\(",
          "captures": {
            "1": { "name": "keyword.other.documentation.squirrel" }
          }
        },
        {
          "match": "^\\s*(#\\s*(?:include|require))\\b",
          "captures": {
            "1": { "name": "keyword.control.import.squirrel" }
          }
        }
      ]
    },
    "preprocessor-expression": {
      "patterns": [
        {
          "match": "\\b(SERVER|CLIENT|UI|SP|MP|DEV|DEVELOPER|CONSOLE_PROG|DURANGO_PROG|PS4_PROG|PC_PROG|LOBBY|MP_PVEMODE|MP_CAMPAIGNCOOP)\\b",
          "name": "constant.language.platform.squirrel"
        },
        {
          "match": "\\b(MAP_\\w+|GAMEMODE_\\w+)\\b",
          "name": "constant.language.condition.squirrel"
        },
        {
          "match": "(&&|\\|\\||!)",
          "name": "keyword.operator.logical.squirrel"
        },
        { "include": "#comments" }
      ]
    },

    "class": {
      "begin": "(?=\\bclass\\b)",
      "end": "(?<=\\})|(;)",
      "endCaptures": {
        "1": { "name": "punctuation.terminator.squirrel" }
      },
      "name": "meta.class.squirrel",
      "patterns": [
        { "include": "#class-name" },
        { "include": "#class-name-post" },
        { "include": "#class-block" }
      ]
    },
    "class-name": {
      "begin": "\\b(class)\\b",
      "beginCaptures": {
        "1": { "name": "storage.type.class.squirrel" }
      },
      "end": "([_A-Za-z][\\w\\.]*)",
      "endCaptures": {
        "1": { "name": "entity.name.type.class.squirrel" }
      },
      "name": "meta.class.identifier.squirrel",
      "patterns": [
        { "include": "#global" }
      ]
    },
    "class-name-post": {
      "begin": "(?<=\\w)",
      "end": "(\\{)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.block.begin.squirrel" }
      },
      "patterns": [
        { "include": "#modifiers-inheritance" },
        {
          "match": "\\b([_A-Za-z][\\w\\.]*)\\b",
          "name": "entity.name.type.class.squirrel"
        }
      ]
    },
    "class-block": {
      "begin": "(?<=\\{)",
      "end": "(\\})",
      "endCaptures": {
        "1": { "name": "punctuation.definition.block.end.squirrel" }
      },
      "name": "meta.block.squirrel",
      "patterns": [
        { "include": "#typed-function-declaration" },
        { "include": "#function-declaration" },
        { "include": "#modifiers" },
        { "include": "#variable" },
        { "include": "#block" },
        { "include": "#block-contents" }
      ]
    },

    "struct": {
      "begin": "\\b(global\\s+)?(struct)\\b",
      "beginCaptures": {
        "1": { "name": "storage.modifier.global.squirrel" },
        "2": { "name": "storage.type.struct.squirrel" }
      },
      "end": "(?<=\\})",
      "name": "meta.struct.squirrel",
      "patterns": [
        {
          "match": "\\b([_A-Za-z][\\w]*)\\b(?=\\s*\\{)",
          "name": "entity.name.type.struct.squirrel"
        },
        { "include": "#struct-block" }
      ]
    },
    "struct-block": {
      "begin": "\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.block.begin.squirrel" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.definition.block.end.squirrel" }
      },
      "name": "meta.struct.body.squirrel",
      "patterns": [
        { "include": "#comments" },
        { "include": "#preprocessor" },
        { "include": "#struct-member" }
      ]
    },
    "struct-member": {
      "patterns": [
        {
          "match": "\\b(array|table)\\s*(<)([^>]+)(>)\\s*(&)?\\s+([_A-Za-z][\\w]*)",
          "captures": {
            "1": { "name": "storage.type.generic.squirrel" },
            "2": { "name": "punctuation.definition.generic.begin.squirrel" },
            "3": {
              "patterns": [
                { "include": "#type-parameters" }
              ]
            },
            "4": { "name": "punctuation.definition.generic.end.squirrel" },
            "5": { "name": "keyword.operator.reference.squirrel" },
            "6": { "name": "variable.other.member.squirrel" }
          }
        },
        {
          "match": "\\b(int|string|float|vector|bool|entity|asset|var|table|array)\\s*(&)?\\s+([_A-Za-z][\\w]*)",
          "captures": {
            "1": { "name": "storage.type.primitive.squirrel" },
            "2": { "name": "keyword.operator.reference.squirrel" },
            "3": { "name": "variable.other.member.squirrel" }
          }
        },
        {
          "match": "\\b([_A-Za-z][\\w]*)\\s*(&)?\\s+([_A-Za-z][\\w]*)\\s*(?==|$)",
          "captures": {
            "1": { "name": "entity.name.type.squirrel" },
            "2": { "name": "keyword.operator.reference.squirrel" },
            "3": { "name": "variable.other.member.squirrel" }
          }
        },
        { "include": "#block-contents" }
      ]
    },

    "typedef": {
      "match": "\\b(global\\s+)?(typedef)\\s+([_A-Za-z][\\w]*)\\s+([_A-Za-z][\\w]*)",
      "captures": {
        "1": { "name": "storage.modifier.global.squirrel" },
        "2": { "name": "storage.type.typedef.squirrel" },
        "3": { "name": "entity.name.type.typedef.squirrel" },
        "4": { "name": "entity.name.type.squirrel" }
      }
    },

    "enum": {
      "begin": "\\b(global\\s+)?(enum)\\b",
      "beginCaptures": {
        "1": { "name": "storage.modifier.global.squirrel" },
        "2": { "name": "storage.type.enum.squirrel" }
      },
      "end": "(?<=\\})|(;)",
      "endCaptures": {
        "1": { "name": "punctuation.terminator.squirrel" }
      },
      "name": "meta.enum.squirrel",
      "patterns": [
        { "include": "#enum-name" },
        { "include": "#enum-block" }
      ]
    },
    "enum-name": {
      "match": "\\b([_A-Za-z][\\w]*)\\b(?=\\s*\\{)",
      "name": "entity.name.type.enum.squirrel"
    },
    "enum-block": {
      "begin": "\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.block.begin.squirrel" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.definition.block.end.squirrel" }
      },
      "name": "meta.enum.body.squirrel",
      "patterns": [
        { "include": "#comments" },
        {
          "match": "\\b([_A-Za-z][\\w]*)\\s*(?==|,|\\})",
          "captures": {
            "1": { "name": "variable.other.enummember.squirrel" }
          }
        },
        { "include": "#constants" },
        { "include": "#operators" },
        { "include": "#punctuation-comma" }
      ]
    },

    "typed-function-declaration": {
      "begin": "\\b(void|int|float|bool|string|vector|entity|asset|var|array(?:<[^>]+>)?|table(?:<[^>]+>)?|[_A-Za-z][\\w]*)\\s+(ornull\\s+)?(function)\\b\\s*(?:(constructor)|([_A-Za-z][\\w]*))?",
      "beginCaptures": {
        "1": { "name": "storage.type.return.squirrel" },
        "2": { "name": "storage.modifier.ornull.squirrel" },
        "3": { "name": "storage.type.function.squirrel" },
        "4": { "name": "entity.name.function.constructor.squirrel" },
        "5": { "name": "entity.name.function.squirrel" }
      },
      "end": "(?<=\\})|(?=;)",
      "name": "meta.function.typed.squirrel",
      "patterns": [
        { "include": "#function-parameters" },
        { "include": "#function-block" }
      ]
    },

    "function-declaration": {
      "begin": "\\b(function)\\b\\s*(?:(constructor)|([_A-Za-z][\\w]*))?",
      "beginCaptures": {
        "1": { "name": "storage.type.function.squirrel" },
        "2": { "name": "entity.name.function.constructor.squirrel" },
        "3": { "name": "entity.name.function.squirrel" }
      },
      "end": "(?<=\\})|(?=;)",
      "name": "meta.function.squirrel",
      "patterns": [
        { "include": "#function-parameters" },
        { "include": "#function-block" }
      ]
    },

    "function-parameters": {
      "begin": "\\(",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.parameters.begin.squirrel" }
      },
      "end": "\\)",
      "endCaptures": {
        "0": { "name": "punctuation.definition.parameters.end.squirrel" }
      },
      "name": "meta.parameters.squirrel",
      "patterns": [
        { "include": "#comments" },
        { "include": "#functionref-parameter" },
        { "include": "#typed-parameter" },
        { "include": "#untyped-parameter" },
        { "include": "#parameter-default" },
        { "include": "#punctuation-comma" }
      ]
    },
    "functionref-parameter": {
      "match": "(void|int|float|bool|string|vector|entity|asset|var|array(?:<[^>]+>)?|table(?:<[^>]+>)?|[_A-Za-z][\\w]*)\\s+(functionref)\\s*\\(([^)]*)\\)\\s+([_A-Za-z][\\w]*)",
      "captures": {
        "1": { "name": "storage.type.return.squirrel" },
        "2": { "name": "storage.type.functionref.squirrel" },
        "3": {
          "patterns": [
            { "include": "#type-parameters" }
          ]
        },
        "4": { "name": "variable.parameter.squirrel" }
      }
    },
    "typed-parameter": {
      "match": "\\b(array|table)\\s*(<)([^>]+)(>)\\s*(&)?\\s*(ornull\\s+)?([_A-Za-z][\\w]*)",
      "captures": {
        "1": { "name": "storage.type.generic.squirrel" },
        "2": { "name": "punctuation.definition.generic.begin.squirrel" },
        "3": {
          "patterns": [
            { "include": "#type-parameters" }
          ]
        },
        "4": { "name": "punctuation.definition.generic.end.squirrel" },
        "5": { "name": "keyword.operator.reference.squirrel" },
        "6": { "name": "storage.modifier.ornull.squirrel" },
        "7": { "name": "variable.parameter.squirrel" }
      }
    },
    "untyped-parameter": {
      "match": "\\b(int|float|bool|string|vector|entity|asset|var|table|array|[_A-Za-z][\\w]*)\\s+(ornull\\s+)?([_A-Za-z][\\w]*)",
      "captures": {
        "1": { "name": "storage.type.squirrel" },
        "2": { "name": "storage.modifier.ornull.squirrel" },
        "3": { "name": "variable.parameter.squirrel" }
      }
    },
    "parameter-default": {
      "begin": "=",
      "beginCaptures": {
        "0": { "name": "keyword.operator.assignment.squirrel" }
      },
      "end": "(?=[,)])",
      "patterns": [
        { "include": "#block-contents" }
      ]
    },

    "type-parameters": {
      "patterns": [
        {
          "match": "\\b(int|float|bool|string|vector|entity|asset|var|void|array|table)\\b",
          "name": "storage.type.primitive.squirrel"
        },
        {
          "match": "\\b([_A-Za-z][\\w]*)\\b",
          "name": "entity.name.type.squirrel"
        },
        {
          "match": ",",
          "name": "punctuation.separator.comma.squirrel"
        },
        {
          "match": "<|>",
          "name": "punctuation.definition.generic.squirrel"
        }
      ]
    },

    "function-block": {
      "begin": "\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.block.begin.squirrel" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.definition.block.end.squirrel" }
      },
      "name": "meta.function.body.squirrel",
      "patterns": [
        { "include": "#block" },
        { "include": "#block-contents" }
      ]
    },

    "lambda-expression": {
      "patterns": [
        {
          "match": "@\\(",
          "name": "storage.type.function.lambda.squirrel"
        },
        {
          "begin": "(@)\\s*\\(",
          "beginCaptures": {
            "1": { "name": "storage.type.function.lambda.squirrel" }
          },
          "end": "\\)",
          "endCaptures": {
            "0": { "name": "meta.brace.round.squirrel" }
          },
          "patterns": [
            { "include": "#block-contents" }
          ]
        }
      ]
    },

    "typed-variables": {
      "patterns": [
        {
          "match": "\\b(array|table)\\s*(<)([^>]+)(>)\\s+([_A-Za-z][\\w]*)",
          "captures": {
            "1": { "name": "storage.type.generic.squirrel" },
            "2": { "name": "punctuation.definition.generic.begin.squirrel" },
            "3": {
              "patterns": [
                { "include": "#type-parameters" }
              ]
            },
            "4": { "name": "punctuation.definition.generic.end.squirrel" },
            "5": { "name": "variable.other.squirrel" }
          }
        }
      ]
    },

    "vector-literal": {
      "comment": "Vector literals like <0, 0, 0> - must have commas to distinguish from comparison operators",
      "match": "(<)\\s*([^<>,]+)\\s*,\\s*([^<>,]+)\\s*,\\s*([^<>]+)\\s*(>)",
      "captures": {
        "1": { "name": "punctuation.definition.vector.begin.squirrel" },
        "2": { "name": "constant.numeric.vector-component.squirrel" },
        "3": { "name": "constant.numeric.vector-component.squirrel" },
        "4": { "name": "constant.numeric.vector-component.squirrel" },
        "5": { "name": "punctuation.definition.vector.end.squirrel" }
      },
      "name": "meta.vector.literal.squirrel"
    },

    "asset-literal": {
      "match": "(\\$)(\"[^\"]*\")",
      "captures": {
        "1": { "name": "punctuation.definition.asset.squirrel" },
        "2": { "name": "string.quoted.double.asset.squirrel" }
      }
    },

    "array": {
      "begin": "\\[",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.array.begin.squirrel" }
      },
      "end": "\\]",
      "endCaptures": {
        "0": { "name": "punctuation.definition.array.end.squirrel" }
      },
      "name": "meta.array.literal.squirrel",
      "patterns": [
        { "include": "#block" },
        { "include": "#block-contents" }
      ]
    },

    "constants": {
      "patterns": [
        {
          "match": "\\btrue\\b",
          "name": "constant.language.boolean.true.squirrel"
        },
        {
          "match": "\\bfalse\\b",
          "name": "constant.language.boolean.false.squirrel"
        },
        {
          "match": "\\bnull\\b",
          "name": "constant.language.null.squirrel"
        },
        {
          "match": "\\b[-]?[0-9]+(\\.)[0-9]+(?:[eE][+-]?[0-9]+)?\\b",
          "captures": {
            "0": { "name": "constant.numeric.float.squirrel" },
            "1": { "name": "meta.delimiter.decimal.period.squirrel" }
          }
        },
        {
          "match": "\\b[-]?[0-9]+[eE][+-]?[0-9]+\\b",
          "name": "constant.numeric.float.scientific.squirrel"
        },
        {
          "match": "\\b0[0-7]+\\b",
          "name": "constant.numeric.integer.octal.squirrel"
        },
        {
          "match": "\\b0[0-9]+\\b",
          "name": "invalid.illegal.integer.octal.squirrel"
        },
        {
          "match": "\\b(0|[1-9][0-9]*)\\b",
          "name": "constant.numeric.integer.decimal.squirrel"
        },
        {
          "match": "\\b0(x|X)[0-9a-fA-F]+\\b",
          "name": "constant.numeric.integer.hexadecimal.squirrel"
        },
        {
          "match": "\\b0(x|X)[\\w]*\\b",
          "name": "invalid.illegal.integer.hexadecimal.squirrel"
        },
        {
          "match": "(\\')(?:[^'\\\\]|(\\\\.|\\\\x[0-9a-fA-F]{2}))(\\')",
          "name": "constant.numeric.integer.other.squirrel",
          "captures": {
            "1": { "name": "punctuation.definition.string.begin.squirrel" },
            "2": {
              "patterns": [
                { "include": "#string-escape-sequences" }
              ]
            },
            "3": { "name": "punctuation.definition.string.end.squirrel" }
          }
        },
        {
          "match": "\\'.{2,}\\'",
          "name": "invalid.illegal.integer.other.squirrel"
        }
      ]
    },

    "comments": {
      "patterns": [
        {
          "begin": "(\\/\\/).*",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.comment.squirrel" }
          },
          "end": "(?=$)",
          "name": "comment.line.double-slash.squirrel"
        },
        {
          "begin": "/\\*",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.begin.squirrel" }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": { "name": "punctuation.definition.comment.end.squirrel" }
          },
          "name": "comment.block.squirrel"
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "begin": "@\\\"",
          "beginCaptures": {
